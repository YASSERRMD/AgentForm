{
  "name": "@agentform/studio-server",
  "version": "0.1.0",
  "private": true,
  "description": "Agentform Studio backend — spec I/O, diagnostics, and (later) GenAI orchestration over a local project directory.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentform/parser": "workspace:*",
    "@agentform/studio-core": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.10.0",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1"
  }
}
